DATABASE_URL=sqlite:///./sql_learning.db
SECRET_KEY=<generate-with-openssl-rand-hex-32>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
QUESTION_DB_PATH=./question_databases/
DIFY_ER_RUBRIC_URL=
DIFY_ER_RUBRIC_API_KEY=
DIFY_ER_RUBRIC_TIMEOUT_SECONDS=600
DIFY_ER_SUBMISSION_URL=
DIFY_ER_SUBMISSION_API_KEY=
DIFY_ER_SUBMISSION_TIMEOUT_SECONDS=600
DIFY_API_KEY=
ER_STORAGE_PROVIDER=local
ER_DIAGRAM_UPLOAD_PATH=./er_diagram_uploads/

# AI Query Review — configure for your provider
# Supported: azure_openai | openai | gemini
AI_PROVIDER=azure_openai
AI_API_KEY=<your-azure-openai-api-key>
AI_MODEL=<your-deployment-name>
AI_TEMPERATURE=0.5
AI_ENABLE_TEMPERATURE=True
AI_AZURE_ENDPOINT=https://<your-resource>.openai.azure.com/
AI_AZURE_API_VERSION=2024-02-01

# Microsoft SSO (Azure Entra ID)
MICROSOFT_CLIENT_ID=<your-azure-app-client-id>
MICROSOFT_TENANT_ID=common

# LOCAL DEVELOPMENT ONLY — set true to enable POST /api/v1/auth/dev-login, which
# signs you in as an existing user without Google/Microsoft. Useful offline, or
# when localhost is not a registered origin on the Google OAuth client.
# LEAVE THIS false IN EVERY DEPLOYED ENVIRONMENT.
DEV_LOGIN_ENABLED=false
