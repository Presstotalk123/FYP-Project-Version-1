// Relational-algebra grammar, following the notation of the course slides
// (CZ2007/SC2207 Topic 5 and Tutorial 5.5). One statement per parse; the parser
// splits a program into statements first (see parser.py).
//
// Operator parameters can be written three ways, because subscripts cannot be typed:
//   σ School = 'SCSE' Students          (as on the slides, no brackets)
//   σ_{School = 'SCSE'} Students        (LaTeX-style subscript)
//   σ[School = 'SCSE'](Students)        (brackets)
//
//   σ c R      Π a, b R      Π Name, Quiz1 + Quiz2 → Total R      ρ S(a, b) R
//   δ R        γ School, AVG(GPA) → AvgGPA R
//   R ⋈ S      R ⋈ cond S    R × S     R ÷ S     R ∪ S    R ∩ S    R − S
//   R ⟕ S      R ⟖ cond S    R ⟗ S
//   T := expr     (or T ← expr)
//
// Precedence, tightest first: σ Π ρ δ γ (apply to the next relation only), then the
// joins / × / ÷, then ∪ ∩ −. Binary operators are left-associative.

start: assignment | expr

assignment: NAME ASSIGN expr

?expr: setexpr

?setexpr: setexpr UNION joinexpr        -> union
        | setexpr INTERSECT joinexpr    -> intersect
        | setexpr MINUS joinexpr        -> difference
        | joinexpr

?joinexpr: joinexpr JOIN unary                  -> natural_join
         | joinexpr JOIN cond_param unary       -> theta_join
         | joinexpr LJOIN unary                 -> left_join
         | joinexpr LJOIN cond_param unary      -> left_theta_join
         | joinexpr RJOIN unary                 -> right_join
         | joinexpr RJOIN cond_param unary      -> right_theta_join
         | joinexpr FJOIN unary                 -> full_join
         | joinexpr FJOIN cond_param unary      -> full_theta_join
         | joinexpr CROSS unary                 -> product
         | joinexpr DIVIDE unary                -> division
         | unary

?unary: SELECT cond_param unary        -> select
      | PROJECT proj_param unary       -> project
      | RENAME rename_param unary      -> rename
      | DISTINCT unary                 -> distinct
      | GROUP group_param unary        -> group
      | atom

?atom: NAME                            -> relation
     | "(" expr ")"

// ── operator parameters ──────────────────────────────────────────────────────
cond_param: "[" condition "]" | SUB condition "}" | condition
proj_param: "[" proj_list "]" | SUB proj_list "}" | proj_list
rename_param: "[" rename_spec "]" | SUB rename_spec "}" | rename_spec
group_param: "[" group_list "]" | SUB group_list "}" | group_list

proj_list: proj_item ("," proj_item)*
proj_item: arith (ARROW NAME)?
?arith: arith PLUS term          -> add
      | arith MINUS term         -> sub
      | term
?term: term TIMES factor         -> mul
     | term DIVBY factor         -> div
     | factor
?factor: attr
       | NUMBER                  -> number
       | "(" arith ")"

rename_spec: NAME ("(" NAME ("," NAME)* ")")?

group_list: group_item ("," group_item)*
group_item: attr                                    -> group_by
          | AGG "(" (attr | STAR) ")" ARROW NAME    -> aggregate

attr: NAME ("." NAME)?

// ── conditions ───────────────────────────────────────────────────────────────
?condition: or_cond
?or_cond: or_cond OR and_cond      -> or_
        | and_cond
?and_cond: and_cond AND not_cond   -> and_
         | not_cond
?not_cond: NOT not_cond            -> not_
         | comparison
         | "(" condition ")"
comparison: operand COMP operand
?operand: attr
        | NUMBER                   -> number
        | MINUS NUMBER             -> negative
        | STRING                   -> string
        | AGG "(" (attr | STAR) ")" -> aggregate_in_condition

// ── tokens ───────────────────────────────────────────────────────────────────
SELECT: "σ" | "\\select"
PROJECT: "π" | "Π" | "\\project"
RENAME: "ρ" | "\\rename"
DISTINCT: "δ" | "\\distinct"
GROUP: "γ" | "\\group"
JOIN: "⋈" | "\\join"
LJOIN: "⟕" | "\\leftjoin"
RJOIN: "⟖" | "\\rightjoin"
FJOIN: "⟗" | "\\fulljoin"
CROSS: "×" | "\\cross"
DIVIDE: "÷" | "\\divide"
UNION: "∪" | "\\union"
INTERSECT: "∩" | "\\intersect"
MINUS: "−" | "-" | "\\diff"
ASSIGN: ":=" | "←"
ARROW: "→" | "->"
SUB.3: "_{"
PLUS: "+"
TIMES: "*"
DIVBY: "/"
STAR: "*"

// Keywords outrank NAME but only as whole words, so "nothing" or "order" stay names.
AND.2: "∧" | /and\b/i
OR.2: "∨" | /or\b/i
NOT.2: "¬" | /not\b/i
AGG.2: /(count|sum|avg|min|max)\b/i
COMP: "<=" | ">=" | "<>" | "!=" | "≠" | "≤" | "≥" | "=" | "<" | ">"

// U+2010 (‐) is never typed by students: normalize.py swaps it in for the "-" inside
// schema names such as teamid-one, so they stay one NAME instead of "teamid − one".
NAME: /[A-Za-z_][A-Za-z0-9_‐]*/
NUMBER: /\d+(\.\d+)?/
// Straight and curly quotes — students paste from the slides and tutorials.
STRING: /'(?:[^']|'')*'/ | /‘[^’]*’/ | /"[^"]*"/ | /“[^”]*”/
COMMENT: /--[^\n]*/ | /\/\/[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT
