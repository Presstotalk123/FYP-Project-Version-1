# Copy this file to .env.local in this frontend directory.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Required for Google login. Fill in your Google OAuth Web Client ID.
# This must match GOOGLE_CLIENT_ID in backend/.env.
# Add http://localhost:3000 to that client's Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Configure these if using Microsoft sign-in.
# Match MICROSOFT_CLIENT_ID / MICROSOFT_TENANT_ID in backend/.env.
# Register http://localhost:3000 as an SPA redirect URI in the Azure app.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_TENANT_ID=common
